#. Plugin Name of the plugin
#: wp-gianism.php
msgid "Gianism"
msgstr "Gianism"

#. Plugin URI of the plugin
#: wp-gianism.php
msgid "https://wordpress.org/extend/plugins/gianism/"
msgstr "https://wordpress.org/extend/plugins/gianism/"

#. Description of the plugin
#: wp-gianism.php
msgid ""
"Connect user accounts with major web services like Facebook, x, etc. Stand "
"on the shoulders of giants!"
msgstr ""
"FacebookやXなどの主要なWebサービスとユーザーアカウントを連携します。巨人の肩"
"の上に立とう！"

